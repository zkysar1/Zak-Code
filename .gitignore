# ──────────────────────────────────────────────────────────────────────────
# Zak Code .gitignore
# ──────────────────────────────────────────────────────────────────────────

# Python bytecode / build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
wheels/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# uv  (uv.lock IS committed for reproducible installs; override any global *.lock ignore)
.uv/
!uv.lock

# Test / type / lint caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Secrets & local config  (NEVER commit API keys)
.env
.env.*
!.env.example
*.local
.zakcode/secrets*

# Zak Code runtime / session state
.zakcode/
*.session.json
*.zaksession

# Research scratch — the extracted clean-room reference material lives OUTSIDE
# this repo on purpose (see docs/GUARDRAILS.md). Never commit it.
_research/
_zakcode_research/
**/claw-code-main/

# One-shot orchestrator scratch (recovery/extraction/smoke helpers); never committed.
# Root-level files starting with "_" are working scratch, not project files.
/_*.py
/_*.txt
/_*.out
COMMIT_MSG.tmp

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Editors / IDEs
.idea/
.vscode/
*.swp
*~
