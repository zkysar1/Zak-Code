+    def _answer_now_is_silent(self) -> bool:
+        """Whether a FINISHED plan on the board is kept silent: it is the plan a turn-end hook
+        refused a stop on (ADR-0205), or (build K) it finished in a turn whose end a hook governs
+        and its draw came up silent. One predicate, read by the reminder and by the per-request
+        trace label; the draw is made by whichever reads first and held until the plan moves."""
+        if self._refused_plan_is_current():
+            return True
+        if not (self._hook_governs_turn_end and self.session.task_network.is_complete()):
+            return False
+        if not self._coin_open:
+            self._coin_open = True
+            if self._coin_owed is None:  # the first plan of a pair: a fair draw
+                self._coin_pair += 1
+                slot, self._coin_silent = 1, self._coin.random() < 0.5
+                self._coin_owed = not self._coin_silent
+            else:  # the second: the other side
+                slot, self._coin_silent, self._coin_owed = 2, self._coin_owed, None
+            side = "silent" if self._coin_silent else "sent"
+            self._note(
+                "intervention",
+                f"answer-now draw for a plan finished in a governed turn: {side} "
+                f"(pair {self._coin_pair}, slot {slot})",
+                kind="answer_now_coin",
+                side=side,
+                pair=self._coin_pair,
+                slot=slot,
+            )
+        return self._coin_silent
+
