+    def _retire_finished_plan(self) -> bool:
+        """Take a finished plan off the board; ``True`` when no live plan is left on it.
+
+        ADR-0110: the finished plan leaves the board, not the record. The two boundaries a
+        finished plan does not outlive share this: a turn start, and a refused stop (see
+        :meth:`_fire_turn_end`). An unfinished plan is left exactly as it is.
+        """
+        session = self.session
+        network = session.task_network
+        if not (network.is_empty() or network.is_complete()):
+            return False
+        if network.tasks:
+            finished, total = network.progress()
+            network.record(
+                "reset",
+                detail=f"completed {finished}/{total}: "
+                + "; ".join(clip(t.title, 40) for t in network.leaves()[:6]),
+            )
+        network.tasks = []  # no-op when already empty; clears a finished plan
+        session.plan_idle_turns = 0
+        session.plan_signature = ""
+        return True
+
