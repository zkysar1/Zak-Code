+    def _forced_tool_choice(self, tools: list[dict[str, Any]] | None) -> str | None:
+        """``"required"`` for a completion that must carry a tool call, else ``None``.
+
+        Owed after the harness delivers the skill a refused stop named, until the model has
+        run one work call or ``_VETO_FORCED_CALLS`` completions have been asked for. Taken
+        once per completion (not per retry of it). A request without tools is never forced.
+        """
+        if self._veto_forced_left <= 0 or not tools:
+            return None
+        if self._work_calls > self._veto_forced_mark:
+            self._veto_forced_left = 0  # the model has acted: nothing further is owed
+            return None
+        self._veto_forced_left -= 1
+        self._note(
+            "intervention",
+            "a refused stop is owed an action: this completion must carry a tool call",
+            kind="veto_forced_tool",
+            left=self._veto_forced_left,
+        )
+        return "required"
+
