+    def _answer_now_is_silent(self) -> bool:
+        """Whether a FINISHED plan on the board is kept silent: it is the plan a turn-end hook
+        refused a stop on (ADR-0205), or (arm L) a hook that names a skill re-entry governs this
+        turn's end. One predicate, read by the reminder and by the per-request trace label."""
+        if self._refused_plan_is_current():
+            return True
+        return self._hook_governs_turn_end and self.session.task_network.is_complete()
