# Zak Code — example environment file. Copy to `.env` and fill in.
# `.env` is gitignored; NEVER commit real keys.
#
# How loading works: `load_settings()` exports this file into the process
# environment at startup (variables already set in the real environment always
# win), then pydantic-settings reads the ZAKCODE_* entries. So BOTH provider
# keys and ZAKCODE_* settings work from this one file — no OS-level
# environment variables required. The file is resolved relative to the
# directory you LAUNCH zakcode from (normally the workspace root).
#
# Per-user config: the SAME format also works at `~/.zakcode/.env` (the user
# config home — put keys/model there ONCE and every zakcode invocation on the
# machine has them). A workspace .env like this one overrides the user file
# per-project. Precedence table: docs/CONFIG.md.

# ══ Provider keys ══════════════════════════════════════════════════════════
# Only the key matching your chosen model's prefix is required; local models
# (Ollama / BitNet / llama.cpp) need no key at all.
# OPENAI_API_KEY=sk-...                  # for openai/* models
# ANTHROPIC_API_KEY=sk-ant-...           # for anthropic/* models
# GROQ_API_KEY=gsk_...                   # for groq/* models
# TAVILY_API_KEY=tvly-...                # only if ZAKCODE_SEARCH_BACKEND=tavily

# ══ Model selection ════════════════════════════════════════════════════════
# litellm model string: `provider/model`. Examples:
#   groq/llama-3.3-70b-versatile   (cloud — fast + cheap, strong tool calling)
#   openai/gpt-4o                  (cloud)
#   openai/gpt-4o-mini             (cloud — cheap)
#   anthropic/claude-sonnet-4-6    (cloud)
#   anthropic/claude-haiku-4-5     (cloud — cheap)
#   ollama_chat/llama3.1           (local Ollama)
#   ollama_chat/qwen2.5-coder      (local Ollama, strong at code + tools)
ZAKCODE_DEFAULT_MODEL=ollama_chat/llama3.1

# Model to retry with if the primary call errors out (cross-provider OK).
# ZAKCODE_FALLBACK_MODEL=openai/gpt-4o-mini

# Per-ROLE model overrides (JSON; keys: planner | subagent | summarizer) so cheap
# roles can run on a cheap/local model while generation uses the capable one.
# ZAKCODE_MODEL_ROLES={"summarizer":"groq/llama-3.1-8b-instant"}

# ZAKCODE_TEMPERATURE=0.0                # 0.0–2.0 (default 0.0)
# ZAKCODE_TOOL_CALLING_MODE=auto         # auto | native | text (auto self-resolves)

# ══ Local backends ═══════════════════════════════════════════════════════════
# ZAKCODE_OLLAMA_BASE_URL=http://localhost:11434

# Any OpenAI-compatible server (llama.cpp / BitNet / vLLM / LM Studio), local or
# on another machine — point at it by config alone:
#   ZAKCODE_DEFAULT_MODEL=openai/qwen2.5-coder
#   ZAKCODE_API_BASE=http://127.0.0.1:8000/v1
#   ZAKCODE_API_KEY=sk-local-noop        # many local servers ignore it but need one present
# ZAKCODE_API_BASE=
# ZAKCODE_API_KEY=

# ══ Agent behavior ═══════════════════════════════════════════════════════════
# ZAKCODE_PERMISSION_MODE=ask            # ask | acceptEdits | allow | autonomous | deny
#   autonomous = unattended posture: everything auto-allows, NOTHING ever prompts,
#   and a catastrophic command (rm -rf /, sudo, ...) is a deterministic hard deny.
# Per-tool mode overrides (JSON; loosen or tighten individual tools):
# ZAKCODE_TOOL_TRUST_OVERRIDES={"bash":"allow","web_fetch":"ask"}
# ZAKCODE_MAX_ITERATIONS=50              # hard cap on agent-loop iterations per turn
# ZAKCODE_PROVIDER_MAX_RETRIES=3         # retries on a rate-limited (429) model call; 0 disables
# ZAKCODE_SUBPROCESS_INHERIT_PROVIDER_KEYS=false  # true = bash/powershell children may read *_API_KEY vars
# ZAKCODE_WORKSPACE_ROOT=                # defaults to the current directory
# Extra deny regexes appended to the dangerous-command blocklist (one per line
# or a JSON array; they can only ever tighten the verdict).
# ZAKCODE_DENIED_COMMANDS=

# ══ Web tools ════════════════════════════════════════════════════════════════
# ZAKCODE_SEARCH_BACKEND=ddgs            # ddgs (free, no key) | tavily | searxng
# ZAKCODE_SEARXNG_URL=                   # when search_backend=searxng
# ZAKCODE_WEB_ALLOWED_DOMAINS=           # restrict web_fetch to these domains (+subdomains)
# ZAKCODE_WEB_FETCH_CONFIRM=false        # confirm every web_fetch (egress gate)

# ══ Network egress sandbox (opt-in) ══════════════════════════════════════════
# ZAKCODE_EGRESS_PROXY=false             # route bash/powershell egress via allowlist proxy
# ZAKCODE_EGRESS_ALLOWED_DOMAINS=        # empty + proxy on = deny all subprocess egress

# ══ Cross-session memory (opt-in via Agent(enable_memory=True)) ═══════════════
# ZAKCODE_MEMORY_DB_PATH=                # default: <workspace>/.zakcode/memory.db
# ZAKCODE_MEMORY_RECALL_LIMIT=5
# ZAKCODE_MEMORY_RECALL_MIN_OVERLAP=1

# ══ HTTP server (zakcode serve) ═══════════════════════════════════════════════
# ZAKCODE_AUTH_TOKEN=                    # bearer token; unset = loopback-only dev
# ZAKCODE_ALLOWED_MODELS=                # allowlist for per-request model overrides

# ══ Terminal UI (zakcode chat) ════════════════════════════════════════════════
# ZAKCODE_ASCII=1                        # force cp1252-safe ASCII glyphs (no unicode)
# ZAKCODE_NO_SPINNER=1                   # disable the wait spinner (it is auto-off on
#                                        # the legacy Windows console; see docs/UX.md)
