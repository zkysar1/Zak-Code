# Zak Code — example environment file.  Copy to `.env` and fill in.
# `.env` is gitignored; NEVER commit real keys.

# ── Provider selection ───────────────────────────────────────────────────
# litellm model string. Examples:
#   ollama_chat/llama3.1         (local, default for dev)
#   ollama_chat/qwen2.5-coder    (local, strong at code + tool calling)
#   openai/gpt-4o                (cloud)
ZAKCODE_DEFAULT_MODEL=ollama_chat/llama3.1

# Optional fallback model used if the primary errors out.
# ZAKCODE_FALLBACK_MODEL=openai/gpt-4o-mini

# ── Local (Ollama) ───────────────────────────────────────────────────────
ZAKCODE_OLLAMA_BASE_URL=http://localhost:11434

# ── OpenAI ───────────────────────────────────────────────────────────────
# Read directly by litellm from the standard variable below:
# OPENAI_API_KEY=sk-...

# ── Agent behavior ───────────────────────────────────────────────────────
ZAKCODE_MAX_ITERATIONS=50
ZAKCODE_PERMISSION_MODE=ask        # ask | acceptEdits | allow | deny
ZAKCODE_TEMPERATURE=0.0
